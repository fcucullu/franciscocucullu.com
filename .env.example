# Copy this file to .env in the project root. .env is gitignored.
# Restart `npm run dev` after you change it.

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# While the domain is not verified, Resend only delivers from this address,
# and only to the email of the Resend account that owns the API key.
# After verifying franciscocucullu.com, use an address on that domain.
CONTACT_FROM_EMAIL=Francisco Cucullu <onboarding@resend.dev>

# Inbox that receives the form. For the test sender above, this must be
# the email of the Resend account.
CONTACT_TO_EMAIL=francisco.cucullu@gmail.com
