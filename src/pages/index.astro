---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import CallToAction from '../components/CallToAction.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';

const latestEssays = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3)
	.map((post) => ({
		title: post.data.title,
		description: post.data.description,
		href: `/blog/${post.id}`,
		tag: post.data.tag,
	}));

const cases = [
	{
		href: '/work/ai-quality-assurance',
		kicker: 'Enterprise',
		title: 'Leading an AI product at scale',
		text: 'Four squads and 24 engineers. A multi-modal product in production for a global CX company: millions saved a year, 50% more efficient, live across 51 accounts. The technology is AI. The job is product leadership.',
	},
	{
		href: '/work/hastee',
		kicker: 'Product leadership',
		title: '137% more engineering output',
		text: 'Tech Product Manager at an HR fintech. Redesigned how 13 engineers across 3 teams delivered, and lined the roadmap up with what the business actually needed.',
	},
	{
		href: '/work/timed-integrations',
		kicker: 'Founder',
		title: 'Built it, then sold it',
		text: 'Factorial’s Italian clients were typing time-tracking in by hand. I built the integration and sold the product to Factorial.',
	},
];

const principles = [
	{
		title: 'Clarity before process',
		text: 'At Hastee the gain did not come from more ceremony. It came from a priority system the teams could execute, tied to C-level goals.',
		href: '/work/hastee',
		icon: 'strategy',
	},
	{
		title: 'Evidence before investment',
		text: 'WASP takes an AI idea to a working prototype in five days, so a company can stop or continue with proof. Same instinct as measuring a 28-second bounce before redesigning the screen.',
		href: '/blog/wasp-framework',
		icon: 'lightbulb',
	},
	{
		title: 'A capability is not a product',
		text: 'Enterprise QA moved because of the workflow around the model, not the model alone. Scout exists for the same reason: a generic agent does not do the job.',
		href: '/blog/scout-focused-product-on-generic-agent',
		icon: 'rocket-launch',
	},
];

const ventures = [
	{
		title: 'Timed Integrations',
		text: 'Saw the gap, built the product alone, sold it to Factorial.',
	},
	{
		title: 'FlexRent',
		text: 'Room exchange for digital nomads. From zero to a community, angel investment, and stages at South Summit, Warsaw, and DES Málaga.',
	},
	{
		title: 'The Pepino Brand',
		text: 'Co-founded a B2B SaaS for agencies. Rebuilt the product, closed 7 customers including Credo and BBK Foundation.',
	},
];

const products = [
	{
		title: 'Clientísima',
		problem: 'Service businesses were running clients across too many tools.',
		user: 'Women who run salons, wellness studios, and clinics.',
		href: 'https://clientisima.com',
	},
	{
		title: 'Hamsela',
		problem: 'Mentors were splitting sessions, tasks, and progress across apps.',
		user: 'Coaches, mentors, and therapists.',
		href: 'https://hamsela.com',
	},
	{
		title: 'Scout',
		problem: 'A generic AI agent can search jobs. It does not reliably do the job.',
		user: 'People who want a daily shortlist matched to their CV.',
		href: 'https://scout.franciscocucullu.com',
	},
];
---

<BaseLayout>
	<div class="stack gap-15 lg:gap-30">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero" data-reveal>
				<Hero
					title="Product <span class='mark'>Leader</span><br/>who builds."
					display
					align="start"
					tagline="Leading software products from 0&#8594;1 to scale. Product, technology, and business. From startups to enterprise."
				>
					<p class="availability">Open to senior product roles. Startups, scaleups, and companies that need an entrepreneur inside.</p>
					<div class="hero-cta">
						<CallToAction href="/contact/#form" data-fast-goal="click_on_hero_cta">
							Let's talk
						</CallToAction>
					</div>
				</Hero>

				<div class="portrait" id="portrait">
					<img
						class="shot is-light"
						alt="Francisco Cucullu"
						width="1024"
						height="1024"
						src="/assets/francisco-light.webp"
					/>
					<img
						class="shot is-dark"
						alt=""
						width="956"
						height="1024"
						src="/assets/francisco-dark.png"
					/>
				</div>
			</header>

			<div data-reveal>
				<Skills />
			</div>
		</div>

		<main class="wrapper stack gap-15 lg:gap-30">
			<section class="section" data-reveal>
				<header class="section-header stack gap-2">
					<p class="kicker">Selected impact</p>
					<h3>Scope, not a stack.</h3>
				</header>
				<div class="cards">
					{cases.map((item) => (
						<a href={item.href} class="card">
							<span class="kicker">{item.kicker}</span>
							<h4>{item.title}</h4>
							<p>{item.text}</p>
						</a>
					))}
				</div>
				<p class="more"><CallToAction href="/portfolio/#work" compact>All the work</CallToAction></p>
			</section>

			<section class="section" data-reveal>
				<header class="section-header stack gap-2">
					<p class="kicker">How I lead</p>
					<h3>Decisions, tied to the work.</h3>
				</header>
				<ol class="principles">
					{principles.map((item) => (
						<li>
							<a href={item.href}>
								<span class="principle-mark"><Icon icon={item.icon} size="1.35rem" /></span>
								<span>
									<h4>{item.title}</h4>
									<p>{item.text}</p>
								</span>
							</a>
						</li>
					))}
				</ol>
			</section>

			<section class="section" data-reveal>
				<header class="section-header stack gap-2">
					<p class="kicker">Entrepreneurship</p>
					<h3>I think like a founder because I've been one.</h3>
					<p>That changes how I lead inside a company. These are not side projects.</p>
				</header>
				<ul class="ventures">
					{ventures.map((item) => (
						<li>
							<h4>{item.title}</h4>
							<p>{item.text}</p>
						</li>
					))}
				</ul>
				<div class="products">
					{products.map((item) => (
						<a href={item.href} class="product" target="_blank" rel="noopener">
							<h4>{item.title}</h4>
							<p>{item.problem}</p>
							<p class="user">{item.user}</p>
						</a>
					))}
				</div>
				<p class="more"><CallToAction href="/portfolio/#apps" compact>More products</CallToAction></p>
			</section>

			<section class="section" data-reveal>
				<header class="section-header stack gap-2">
					<p class="kicker">Complex technology</p>
					<h3>AI is part of the record. Not the job title.</h3>
					<p>
						I lead enterprise AI in production, and earlier I built custom ML with a team of five PhDs at a UNICEF-backed fintech. Useful proof that I can take on hard technology. The category is still product leadership.
					</p>
				</header>
				<div class="actions">
					<CallToAction href="/work/ai-quality-assurance" compact>The enterprise case</CallToAction>
					<CallToAction href="/work/quantitative-finance-for-blockchain" compact>Xcapit</CallToAction>
				</div>
			</section>

			<section class="section" data-reveal>
				<header class="section-header stack gap-2">
					<p class="kicker">Thinking</p>
					<h3>Notes from the work.</h3>
					<p>Product decisions, teams, and building. It grows when there is something to say.</p>
				</header>
				<div class="cards">
					{latestEssays.map((essay) => (
						<a href={essay.href} class="card">
							<span class="kicker">{essay.tag}</span>
							<h4>{essay.title}</h4>
							<p>{essay.description}</p>
						</a>
					))}
				</div>
				<p class="more"><CallToAction href="/blog/" compact>All notes</CallToAction></p>
			</section>

			<section class="section" data-reveal>
				<header class="section-header stack gap-2">
					<p class="kicker">Path</p>
					<h3>Why this profile makes sense.</h3>
				</header>
				<ol class="path">
					<li>Economics and quantitative finance.</li>
					<li>Deep into software, on a trading desk.</li>
					<li>From building the tools to leading the team.</li>
					<li>Founded products and companies.</li>
					<li>Led larger teams and products, including enterprise AI.</li>
					<li>Product, software, business, and a founder’s way of deciding.</li>
				</ol>
				<p class="more"><CallToAction href="/about/" compact>Read the story</CallToAction></p>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<script>
	const portrait = document.getElementById('portrait');
	const root = document.documentElement;
	let previousDark = root.classList.contains('theme-dark');
	let audio: AudioContext | null = null;
	let live: { stop: () => void } | null = null;

	function flash() {
		let el = document.querySelector('.mode-flash');
		if (!el) {
			el = document.createElement('div');
			el.className = 'mode-flash';
			document.body.appendChild(el);
		}
		el.classList.remove('is-on');
		void (el as HTMLElement).offsetWidth;
		el.classList.add('is-on');
	}

	function playTone() {
		const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
		if (!AC) return;
		audio = audio ?? new AC();
		if (audio.state === 'suspended') audio.resume();
		live?.stop();
		const ctx = audio;
		const t = ctx.currentTime;
		const master = ctx.createGain();
		master.gain.setValueAtTime(0.0001, t);
		master.gain.exponentialRampToValueAtTime(0.045, t + 0.05);
		master.gain.exponentialRampToValueAtTime(0.0001, t + 0.55);
		master.connect(ctx.destination);

		const oscs = [196, 293.66].map((freq, i) => {
			const osc = ctx.createOscillator();
			osc.type = 'sine';
			osc.frequency.setValueAtTime(freq, t);
			const gain = ctx.createGain();
			gain.gain.setValueAtTime(i === 0 ? 0.8 : 0.28, t);
			osc.connect(gain).connect(master);
			osc.start(t);
			osc.stop(t + 0.58);
			return osc;
		});

		live = {
			stop() {
				const now = ctx.currentTime;
				const level = Math.max(master.gain.value, 0.001);
				master.gain.cancelScheduledValues(now);
				master.gain.setValueAtTime(level, now);
				master.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
				oscs.forEach((osc) => {
					try {
						osc.stop(now + 0.1);
					} catch {
						/* already stopped */
					}
				});
			},
		};
	}

	window.addEventListener('pointerdown', () => {
		const AC = window.AudioContext;
		if (!AC) return;
		audio = audio ?? new AC();
		if (audio.state === 'suspended') audio.resume();
	});

	portrait?.addEventListener('pointerenter', () => {
		previousDark = root.classList.contains('theme-dark');
		root.classList.toggle('theme-dark', !previousDark);
		flash();
		playTone();
	});

	portrait?.addEventListener('pointerleave', () => {
		root.classList.toggle('theme-dark', previousDark);
		live?.stop();
	});
</script>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		gap: 1.25rem;
		border-bottom: 1px solid color-mix(in srgb, var(--gray-0) 12%, transparent);
	}

	.hero :global(.title) {
		max-width: 16ch;
	}

	.hero :global(.mark) {
		background: var(--accent-regular);
		color: var(--accent-text-over);
		padding: 0 0.18em;
		border-radius: 0.12em;
	}

	.availability {
		font-size: var(--text-sm);
		color: var(--gray-300);
		max-width: 38ch;
	}

	.hero-cta {
		margin-top: 0.5rem;
	}

	.portrait {
		position: relative;
		align-self: center;
		width: min(78%, 22rem);
		margin-top: 0.5rem;
		line-height: 0;
		cursor: pointer;
		background: none;
	}

	.portrait .shot {
		display: block;
		width: 100%;
		height: auto;
		background: none;
	}

	.portrait .is-dark {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: bottom center;
		opacity: 0;
	}

	:global(html.theme-dark) .portrait .is-light {
		opacity: 0;
	}

	:global(html.theme-dark) .portrait .is-dark {
		opacity: 1;
	}

	:global(.mode-flash) {
		position: fixed;
		inset: 0;
		background: #fff;
		opacity: 0;
		pointer-events: none;
		z-index: 80;
	}

	:global(.mode-flash.is-on) {
		animation: mode-flash 260ms ease-out;
	}

	@keyframes mode-flash {
		0% {
			opacity: 0.28;
		}
		100% {
			opacity: 0;
		}
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 1.15fr 0.85fr;
			align-items: end;
			gap: 2rem 3rem;
		}

		.portrait {
			align-self: end;
			justify-self: end;
			width: min(100%, 28rem);
			margin-top: 0;
		}

		.hero :global(.title),
		.hero :global(.tagline),
		.availability {
			margin-inline: 0;
		}
	}

	.section {
		display: grid;
		gap: 1.5rem;
	}

	.section-header {
		max-width: 40rem;
	}

	.section-header h3 {
		font-size: clamp(1.8rem, 3vw, 2.6rem);
	}

	.section-header p:not(.kicker) {
		color: var(--gray-300);
		font-size: var(--text-md);
	}

	.kicker {
		font-family: var(--font-body);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-400);
	}

	.cards,
	.products {
		display: grid;
		gap: 1rem;
	}

	.card,
	.product {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		padding: 1.35rem 1.4rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: transparent;
		text-decoration: none;
		color: inherit;
	}

	a.card:hover,
	a.product:hover {
		border-color: var(--accent-regular);
	}

	.section[data-reveal] .card,
	.section[data-reveal] .product,
	.section[data-reveal] .path li {
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 0.55s ease, transform 0.55s ease, border-color 0.2s ease;
	}

	.section.is-in .card,
	.section.is-in .product,
	.section.is-in .path li {
		opacity: 1;
		transform: none;
	}

	.section.is-in .card:nth-child(2),
	.section.is-in .product:nth-child(2),
	.section.is-in .path li:nth-child(2) {
		transition-delay: 70ms;
	}

	.section.is-in .card:nth-child(3),
	.section.is-in .product:nth-child(3),
	.section.is-in .path li:nth-child(3) {
		transition-delay: 140ms;
	}

	.section.is-in .path li:nth-child(4) {
		transition-delay: 210ms;
	}

	.section.is-in .path li:nth-child(5) {
		transition-delay: 280ms;
	}

	.section.is-in .path li:nth-child(6) {
		transition-delay: 350ms;
	}

	.card h4,
	.product h4 {
		font-size: var(--text-lg);
		margin: 0;
	}

	.card p,
	.product p {
		margin: 0;
		color: var(--gray-300);
		font-size: var(--text-sm);
		line-height: 1.6;
	}

	.user {
		color: var(--gray-0);
		font-weight: 600;
	}

	.more {
		margin: 0;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.principles,
	.ventures {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 1.25rem;
	}

	.principles a {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.9rem;
		align-items: start;
		text-decoration: none;
		color: inherit;
	}

	.principle-mark {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: var(--radius-ui);
		background: var(--accent-regular);
		color: var(--accent-text-over);
	}

	.principles h4,
	.ventures h4 {
		margin: 0 0 0.35rem;
		font-size: var(--text-lg);
	}

	.principles p,
	.ventures p {
		margin: 0;
		color: var(--gray-300);
		font-size: var(--text-sm);
		line-height: 1.6;
	}

	.ventures li {
		padding-top: 0.85rem;
		border-top: 2px solid var(--accent-regular);
	}

	.path {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.75rem;
		counter-reset: step;
	}

	.path li {
		counter-increment: step;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.85rem;
		align-items: baseline;
		color: var(--gray-200);
	}

	.path li::before {
		content: counter(step, decimal-leading-zero);
		font-family: var(--font-display);
		color: var(--gray-0);
		font-size: var(--text-lg);
	}

	@media (min-width: 50em) {
		.cards,
		.products,
		.principles,
		.ventures {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.25rem;
		}
	}
</style>
