---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { getCollection } from 'astro:content';

const MONTHS = [
	'January', 'February', 'March', 'April', 'May', 'June',
	'July', 'August', 'September', 'October', 'November', 'December',
];

function formatDate(date: Date): string {
	// Month-precision dates render as "Month Year"; year-only as just the year.
	const month = date.getUTCMonth();
	const day = date.getUTCDate();
	const year = date.getUTCFullYear();
	if (month === 0 && day === 1) return `${year}`;
	return `${MONTHS[month]} ${year}`;
}

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const articles = posts.map((post) => ({
	title: post.data.title,
	description: post.data.description,
	href: `/blog/${post.id}`,
	tag: post.data.tag,
	date: formatDate(post.data.pubDate),
	external: false,
}));

// The "Dealing with Heteroscedasticity" piece lives on LinkedIn (no local page),
// so it is kept here as an external listing to preserve the original index.
articles.push({
	title: 'Dealing with Heteroscedasticity',
	description:
		'Technical article on statistical modeling and handling non-constant variance in financial data.',
	href: 'https://www.linkedin.com/pulse/dealing-heterocedaticity-francisco-cucullu',
	tag: 'Quantitative Finance',
	date: '2019',
	external: true,
});
---

<BaseLayout
	title="Thinking | Francisco Cucullu"
	description="Notes on product decisions, teams, and building software."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Thinking"
				display
				tagline="Notes on product decisions, teams, and building software. Published when there is something to say."
				align="center"
			/>

			<div class="articles-grid">
					{articles.map((article) => (
						<a href={article.href} target={article.external ? "_blank" : undefined} rel={article.external ? "noopener" : undefined} class="card">
							<span class="kicker">{article.tag}{article.external ? ' · External' : ''}</span>
							<h3>{article.title}</h3>
							<p>{article.description}</p>
							<span class="card-meta">{article.date}</span>
						</a>
					))}
			</div>

		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.articles-grid {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 50em) {
		.articles-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.25rem;
		}
	}
</style>
