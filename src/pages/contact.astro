---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';

const channels = [
	{
		label: 'LinkedIn',
		href: 'https://linkedin.com/in/franciscocucullu',
		icon: 'linkedin-logo',
		goal: 'click_on_contact_linkedin',
	},
	{
		label: 'X',
		href: 'https://x.com/fcucullu',
		icon: 'x-logo',
		goal: 'click_on_contact_x',
	},
	{
		label: 'GitHub',
		href: 'https://github.com/fcucullu',
		icon: 'github-logo',
		goal: 'click_on_contact_github',
	},
];
---

<BaseLayout title="Let's talk | Francisco Cucullu" description="Open to senior product leadership roles, startups, and companies that need an entrepreneur inside. Remote.">
	<main class="wrapper contact-page">
		<div class="contact-split">
			<Hero
				title="Let's talk"
				display
				tagline="Senior product roles, startups, and companies that need someone who can lead the product and still build. I also take the occasional collaboration or advisory brief. I read every message."
				align="start"
			/>

			<div class="contact-panel">
			<button type="button" class="open-form" id="open-form">Send a message</button>

			<div id="form">
				<form id="contact-form" class="contact-form">
					<div class="hp" aria-hidden="true">
						<label>
							Company
							<input name="hp_field" type="text" tabindex="-1" autocomplete="off" />
						</label>
					</div>
					<label>
						Full name
						<input name="name" type="text" autocomplete="name" required maxlength="120" />
					</label>
					<label>
						Email
						<input name="email" type="email" autocomplete="email" required maxlength="200" />
					</label>
					<label>
						Message
						<textarea name="message" rows="6" required maxlength="5000"></textarea>
					</label>
					<button type="submit">Send</button>
					<p class="form-status" role="status" aria-live="polite"></p>
				</form>
			</div>
			</div>
		</div>

			<ul class="channels">
				{
					channels.map(({ label, href, icon, goal }) => (
						<li>
							<a href={href} data-fast-goal={goal}>
								<Icon icon={icon} color="currentColor" />
								<span>{label}</span>
							</a>
						</li>
					))
				}
			</ul>
	</main>

	<dialog id="contact-dialog" aria-labelledby="dialog-title">
		<div class="dialog-bar">
			<h2 id="dialog-title">Let's talk</h2>
			<button type="button" id="close-form">Close</button>
		</div>
		<div id="dialog-host"></div>
	</dialog>
</BaseLayout>

<script>
	const form = document.getElementById('contact-form');
	const host = document.getElementById('form');
	const dialogHost = document.getElementById('dialog-host');
	const dialog = document.getElementById('contact-dialog');
	const openButton = document.getElementById('open-form');
	const closeButton = document.getElementById('close-form');
	const mobile = window.matchMedia('(max-width: 49.99em)');

	const placeForm = () => {
		if (!form || !host || !dialogHost || !openButton) return;
		if (mobile.matches) {
			dialogHost.append(form);
			openButton.hidden = false;
		} else {
			host.append(form);
			openButton.hidden = true;
			dialog?.close();
		}
	};

	const openDialog = () => {
		if (!mobile.matches || !dialog) return;
		placeForm();
		dialog.showModal();
	};

	placeForm();
	mobile.addEventListener('change', placeForm);
	openButton?.addEventListener('click', openDialog);
	closeButton?.addEventListener('click', () => dialog?.close());
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});

	if (mobile.matches && location.hash === '#form') openDialog();

	const fields = () =>
		form.querySelectorAll('input, textarea, button[type="submit"]');

	const lockForm = (locked) => {
		fields().forEach((field) => {
			field.disabled = locked;
		});
	};

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const submit = form.querySelector('button[type="submit"]');
		const status = form.querySelector('.form-status');
		if (!submit || !status || submit.disabled) return;

		const payloadBody = new FormData(form);
		lockForm(true);
		status.dataset.state = '';
		status.textContent = 'Sending…';

		try {
			const response = await fetch('/api/contact', {
				method: 'POST',
				body: payloadBody,
			});
			const payload = await response.json().catch(() => ({}));
			if (!response.ok) {
				status.dataset.state = 'error';
				status.textContent = payload.message || 'Something went wrong. Please try again.';
				lockForm(false);
				return;
			}
			form.reset();
			status.dataset.state = 'ok';
			let left = 60;
			const tick = () => {
				status.textContent = `Message sent. You can send another in ${left}s.`;
				if (left <= 0) {
					status.textContent = 'Message sent.';
					lockForm(false);
					return;
				}
				left -= 1;
				window.setTimeout(tick, 1000);
			};
			tick();
		} catch {
			status.dataset.state = 'error';
			status.textContent = 'Something went wrong. Please try again.';
			lockForm(false);
		}
	});
</script>

<style>
	.open-form,
	.contact-form button,
	#close-form {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		padding: 0.7rem 1.25rem;
		border: 0;
		border-radius: var(--radius-ui);
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.open-form[hidden] {
		display: none;
	}

	.contact-form {
		display: grid;
		gap: 1rem;
		max-width: 36rem;
	}

	.contact-form label {
		display: grid;
		gap: 0.4rem;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--gray-0);
	}

	.contact-form input,
	.contact-form textarea {
		width: 100%;
		padding: 0.75rem 0.85rem;
		border: 1px solid var(--gray-800);
		border-radius: var(--radius-ui);
		background: transparent;
		color: var(--gray-0);
		font: inherit;
		font-weight: 400;
	}

	.contact-form textarea {
		resize: vertical;
	}

	.contact-form button:disabled {
		opacity: 0.5;
		cursor: default;
	}

	.hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.form-status {
		min-height: 1.2em;
		margin: 0;
		font-size: var(--text-sm);
		font-weight: 400;
	}

	.form-status[data-state='ok'] {
		padding: 0.9rem 1rem;
		border-radius: var(--radius-ui);
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-size: var(--text-md);
		font-weight: 600;
	}

	.form-status[data-state='error'] {
		color: #f87171;
	}

	.contact-page {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.channels {
		display: flex;
		flex-wrap: nowrap;
		justify-content: center;
		gap: 1.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.channels :global(svg) {
		--size: 1.5rem;
	}

	.channels a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--gray-0);
		text-decoration: none;
		font-weight: 600;
	}

	.channels a:hover,
	.channels a:focus {
		color: var(--accent-dark);
	}

	#contact-dialog {
		width: min(100% - 1.5rem, 32rem);
		max-height: calc(100% - 2rem);
		margin: auto;
		padding: 1.25rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gray-999);
		color: var(--gray-0);
	}

	#contact-dialog::backdrop {
		background: rgba(19, 28, 74, 0.45);
	}

	.dialog-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.dialog-bar h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: var(--text-xl);
	}

	#close-form {
		background: transparent;
		color: var(--gray-0);
		border: 1px solid var(--gray-800);
	}

	@media (min-width: 50em) {
		.open-form {
			display: none;
		}

		.contact-split {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(20rem, 32rem);
			column-gap: 4rem;
			align-items: start;
		}

		.contact-form {
			max-width: none;
		}

		.channels {
			gap: 3.5rem;
			padding-top: 1.5rem;
		}

		.channels a {
			flex-direction: column;
			gap: 0.75rem;
		}

		.channels :global(svg) {
			--size: 3.75rem;
		}
	}
</style>
