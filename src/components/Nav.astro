---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { iconPaths } from './IconPaths';

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
	{ label: 'Work', href: '/portfolio/' },
	{ label: 'Thinking', href: '/blog/' },
	{ label: 'About', href: '/about/' },
];

/** Icon links to social media — edit these with links to your profiles! */
const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths; goal: string }[] = [
	{ label: 'LinkedIn', href: 'https://linkedin.com/in/franciscocucullu', icon: 'linkedin-logo', goal: 'click_on_header_linkedin' },
	{ label: 'GitHub', href: 'https://github.com/fcucullu', icon: 'github-logo', goal: 'click_on_header_github' },	
	{ label: 'Email', href: 'mailto:francisco.cucullu@gmail.com', icon: 'mail-outline', goal: 'click_on_header_mail' },
	{ label: 'X', href: 'https://x.com/fcucullu', icon: 'x-logo', goal: 'click_on_header_x' },
];
---

<nav>
	<div class="menu-header">
		<a href="/" class="site-title">
			<img src="/assets/logo.png" alt="Francisco Cucullu" width="363" height="164" />
		</a>
		<div class="header-actions">
			<a class="nav-cta header-cta" href="/contact/#form">Let's talk</a>
			<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<svg class="menu-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
						<line class="line1" x1="4" y1="6" x2="20" y2="6" />
						<line class="line2" x1="4" y1="12" x2="20" y2="12" />
						<line class="line3" x1="4" y1="18" x2="20" y2="18" />
					</svg>
				</button>
			</template>
		</menu-button>
		</div>
	</div>
	<noscript>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={Astro.url.pathname === href}
							class:list={[
								'link',
								{
									active:
										Astro.url.pathname === href ||
										(href !== '/' && Astro.url.pathname.startsWith(href)),
								},
							]}
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>
	<noscript>
		<div class="menu-footer">
			<a class="nav-cta" href="/contact/#form">Let's talk</a>
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label, goal }) => (
						<a href={href} class="social" data-fast-goal={goal}>
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
		</div>
	</noscript>
	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={Astro.url.pathname === href}
							class:list={[
								'link',
								{
									active:
										Astro.url.pathname === href ||
										(href !== '/' && Astro.url.pathname.startsWith(href)),
								},
							]}
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
			<a class="nav-cta" href="/contact/#form">Let's talk</a>
			<div class="theme-toggle">
				<ThemeToggle />
			</div>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			// Add "menu-content" class in JS to avoid covering content in non-JS browsers.
			menu.classList.add('menu-content');

			const desktopQuery = window.matchMedia('(min-width: 50em)');
			const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				if (desktopQuery.matches) {
					menu.hidden = false;
					menu.classList.add('is-open');
					return;
				}
				if (expand) {
					menu.hidden = false;
					if (motionQuery.matches) {
						menu.classList.add('is-open');
						return;
					}
					requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('is-open')));
					return;
				}
				menu.classList.remove('is-open');
				if (menu.hidden || motionQuery.matches) {
					menu.hidden = true;
					return;
				}
				let settled = false;
				const finish = () => {
					if (settled) return;
					settled = true;
					menu.hidden = true;
				};
				menu.addEventListener(
					'transitionend',
					(event) => {
						if (event.target === menu) finish();
					},
					{ once: true },
				);
				window.setTimeout(finish, 320);
			};

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener('click', () => setExpanded(menu.hidden));

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			const mediaQueries = desktopQuery;
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	nav {
		z-index: 9999;
		position: sticky;
		top: 0;
		font-family: var(--font-brand);
		font-weight: 500;
		margin-bottom: 3.5rem;
		background: var(--gray-999);
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 1.5rem;
	}

	.site-title {
		display: flex;
		align-items: center;
		line-height: 0;
		text-decoration: none;
	}

	.site-title img {
		height: 3.35rem;
		width: auto;
	}

	.nav-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.55rem 1.05rem;
		border-radius: var(--radius-ui);
		background: var(--accent-regular);
		color: var(--accent-text-over);
		font-weight: 600;
		font-size: var(--text-sm);
		text-decoration: none;
		white-space: nowrap;
	}

	.nav-cta:hover,
	.nav-cta:focus {
		background: var(--accent-dark);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.header-cta {
		display: none;
	}

	.menu-button {
		position: relative;
		display: flex;
		border: 1px solid var(--gray-800);
		border-radius: var(--radius-ui);
		padding: 0.5rem;
		color: var(--gray-0);
		background: transparent;
		box-shadow: none;
	}

	.menu-button[aria-expanded='true'] {
		color: var(--gray-0);
		background: transparent;
	}

	.menu-icon {
		display: block;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}

	.menu-icon line {
		transform-box: fill-box;
		transform-origin: center;
		transition: transform 0.35s cubic-bezier(0.34, 1.3, 0.64, 1), opacity 0.2s ease;
	}

	.menu-button[aria-expanded='true'] .line1 {
		transform: translateY(6px) rotate(45deg);
	}

	.menu-button[aria-expanded='true'] .line2 {
		opacity: 0;
	}

	.menu-button[aria-expanded='true'] .line3 {
		transform: translateY(-6px) rotate(-45deg);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-content {
		position: absolute;
		left: 0;
		right: 0;
		opacity: 0;
		transform: translateY(-0.5rem);
		transition: opacity 0.28s ease, transform 0.28s ease;
	}

	.menu-content.is-open {
		opacity: 1;
		transform: none;
	}

	.menu-content .link {
		opacity: 0;
		transform: translateY(0.4rem);
	}

	.menu-content.is-open .link {
		opacity: 1;
		transform: none;
		transition: opacity 0.28s ease, transform 0.28s ease;
	}

	.menu-content.is-open .nav-items li:nth-child(2) .link {
		transition-delay: 40ms;
	}

	.menu-content.is-open .nav-items li:nth-child(3) .link {
		transition-delay: 80ms;
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-size: var(--text-md);
		line-height: 1.2;
		list-style: none;
		padding: 2rem;
		background-color: var(--gray-999);
		border-bottom: 1px solid var(--gray-800);
	}

	.link {
		display: inline-block;
		color: var(--gray-300);
		text-decoration: none;
	}

	.link.active {
		color: var(--gray-0);
	}

	.menu-footer {
		--icon-size: var(--text-xl);
		--icon-padding: 0.5rem;

		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1.5rem 2rem 1.5rem 1.5rem;
		background-color: var(--gray-999);
		border-radius: 0 0 0.75rem 0.75rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.socials {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.25rem;
		font-size: var(--icon-size);
	}

	.social {
		display: flex;
		padding: var(--icon-padding);
		text-decoration: none;
		color: var(--accent-dark);
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus {
		color: var(--accent-text-over);
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
	}

	@media (min-width: 50em) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			padding: 1.15rem 5rem;
			gap: 1rem;
		}

		.menu-header {
			padding: 0;
		}

		.site-title img {
			height: 4.15rem;
		}

		.menu-content {
			display: contents;
			opacity: 1;
			transform: none;
		}

		.menu-content .link,
		.menu-content.is-open .link {
			opacity: 1;
			transform: none;
			transition: color var(--theme-transition), background-color var(--theme-transition);
		}

		.nav-items {
			position: relative;
			flex-direction: row;
			font-size: 0.72rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			border-radius: var(--radius-ui);
			border: 1px solid var(--gray-800);
			padding: 0.5rem 0.5625rem;
			background: transparent;
			box-shadow: none;
		}

		.link {
			padding: 0.5rem 1rem;
			border-radius: var(--radius-ui);
			transition:
				color var(--theme-transition),
				background-color var(--theme-transition);
		}

		.link:hover,
		.link:focus {
			color: var(--gray-100);
			background-color: var(--accent-subtle-overlay);
		}

		.link.active {
			color: var(--accent-text-over);
			background-color: var(--accent-regular);
		}

		.menu-footer {
			--icon-padding: 0.375rem;

			justify-self: flex-end;
			align-items: center;
			padding: 0;
			background-color: transparent;
			border: 0;
			box-shadow: none;
		}

		.socials {
			display: none;
		}
	}

	@media (min-width: 60em) {
		.socials {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.menu-content,
		.menu-content .link,
		.menu-icon line {
			transition: none;
		}
	}

	@media (forced-colors: active) {
		.link.active {
			color: SelectedItem;
		}
	}
</style>
