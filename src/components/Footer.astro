---
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();

const socials = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/franciscocucullu/', icon: 'linkedin-logo' as const, goal: 'click_on_footer_linkedin' },
	{ label: 'GitHub', href: 'https://github.com/fcucullu', icon: 'github-logo' as const, goal: 'click_on_footer_github' },
	{ label: 'Mail', href: '/contact/#form', icon: 'mail-outline' as const, goal: 'click_on_footer_mail' },
	{ label: 'X (Twitter)', href: 'https://x.com/fcucullu', icon: 'x-logo' as const, goal: 'click_on_footer_x' },
];
---

<footer>
	<div class="group">
		<p>Senior product leader. Founder mindset.</p>
		<p>&copy; {currentYear} Francisco Cucullu</p>
	</div>
	<p class="socials">
		{socials.map(({ label, href, icon, goal }) => (
			<a href={href} data-fast-goal={goal}>
				<Icon icon={icon} size="1.1em" />
				{label}
			</a>
		))}
	</p>
</footer>

<style>
	footer {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-top: auto;
		padding: 2.5rem 6.5rem 6.5rem 1.75rem;
		color: var(--gray-400);
		font-size: var(--text-sm);
	}

	.group {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		margin: 0;
	}

	.socials a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--gray-300);
		text-decoration: none;
	}

	.socials a:hover {
		color: var(--gray-0);
	}

	@media (min-width: 50em) {
		footer {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
			padding: 2.75rem 9rem 2.75rem 4.5rem;
		}
	}
</style>
