---
interface Props {
	name: string;
}

const glyphs: Record<string, string> = {
	shield: `<path d="M12 3 5 6v6c0 5 3.2 7.6 7 9 3.8-1.4 7-4 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>`,
	users: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="3"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a3 3 0 0 1 0 5.75"/>`,
	plug: `<path d="M9 7v4"/><path d="M15 7v4"/><path d="M7 11h10v2a5 5 0 0 1-10 0v-2Z"/><path d="M12 18v3"/>`,
	home: `<path d="m4 11 8-7 8 7"/><path d="M6 10v10h12V10"/>`,
	briefcase: `<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/>`,
	lightning: `<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>`,
	compass: `<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 6-6 2 2-6 6-2Z"/>`,
	file: `<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5"/><path d="M8 13h8"/><path d="M8 17h5"/>`,
	chat: `<path d="M5 17 3 21l4-1a9 9 0 1 0-2-3Z"/>`,
	search: `<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>`,
	cpu: `<rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v4"/><path d="M15 2v4"/><path d="M9 18v4"/><path d="M15 18v4"/><path d="M2 9h4"/><path d="M2 15h4"/><path d="M18 9h4"/><path d="M18 15h4"/>`,
	flow: `<path d="M4 6h6v4H4z"/><path d="M14 14h6v4h-6z"/><path d="M7 10v4h7"/><path d="M17 10V8H7"/>`,
	chart: `<path d="M4 19V5"/><path d="M4 19h16"/><path d="m7 14 4-4 3 3 5-6"/>`,
};

const { name } = Astro.props;
const draw = glyphs[name] ?? glyphs.file;
---

<span class="glyph">
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={draw} />
</span>

<style>
	.glyph {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		flex-shrink: 0;
		border: 1px solid var(--gray-800);
		border-radius: var(--radius-ui);
		color: var(--gray-0);
	}

	svg {
		width: 1.35rem;
		height: 1.35rem;
	}
</style>
