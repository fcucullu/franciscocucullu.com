---
import CallToAction from './CallToAction.astro';
---

<aside data-fast-scroll="scroll_to_end" data-reveal>
	<h2>A product, a team, or a company to move?</h2>
	<CallToAction data-fast-goal="click_on_send_me_a_message" href="/contact/#form">
		Let's talk
	</CallToAction>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background-color: var(--gray-999);
	}

	h2 {
		font-family: var(--font-display);
		font-weight: 400;
		letter-spacing: -0.02em;
		font-size: var(--text-xl);
		text-align: center;
		max-width: 16ch;
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem 1.5rem;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: center;
		}
	}
</style>
