---

<div class="carousel">
	<ul class="track" id="rec-track">
		{recommendations.map((item) => (
			<li class="quote">
				<blockquote>{item.text}</blockquote>
				<footer>
					<p class="name">{item.name}</p>
					<p class="role">{item.role}</p>
					<p class="context">{item.context}</p>
				</footer>
			</li>
		))}
	</ul>

	<div class="controls">
		<button type="button" class="nav" data-dir="-1" aria-label="Previous recommendations">←</button>
		<button type="button" class="nav" data-dir="1" aria-label="More recommendations">→</button>
		<p class="count">{recommendations.length} recommendations on LinkedIn</p>
	</div>
</div>

<script>
	const track = document.getElementById('rec-track');

	if (track) {
		const step = () => {
			const card = track.querySelector('.quote');
			return card ? card.getBoundingClientRect().width + 20 : track.clientWidth;
		};

		const move = (dir: number) => {
			const end = track.scrollWidth - track.clientWidth - 4;
			// al llegar al final, vuelve al principio en vez de quedarse clavado
			if (dir > 0 && track.scrollLeft >= end) {
				track.scrollTo({ left: 0, behavior: 'smooth' });
				return;
			}
			if (dir < 0 && track.scrollLeft <= 4) {
				track.scrollTo({ left: end, behavior: 'smooth' });
				return;
			}
			track.scrollBy({ left: dir * step(), behavior: 'smooth' });
		};

		document.querySelectorAll('.nav').forEach((button) => {
			button.addEventListener('click', () => move(Number((button as HTMLElement).dataset.dir)));
		});

		// Avance automatico. Se para solo con el raton encima, con el foco dentro,
		// con la pestana en segundo plano o si el sistema pide menos movimiento.
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
		let timer: ReturnType<typeof setInterval> | null = null;

		const stop = () => {
			if (timer) clearInterval(timer);
			timer = null;
		};

		const play = () => {
			if (timer || reduce.matches || document.hidden) return;
			timer = setInterval(() => move(1), 6000);
		};

		track.addEventListener('pointerenter', stop);
		track.addEventListener('pointerleave', play);
		track.addEventListener('focusin', stop);
		track.addEventListener('focusout', play);
		document.querySelectorAll('.nav').forEach((button) => {
			button.addEventListener('focus', stop);
			button.addEventListener('blur', play);
		});
		document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));
		reduce.addEventListener('change', () => (reduce.matches ? stop() : play()));

		play();
	}
</script>

<style>
	.carousel {
		display: grid;
		gap: 1rem;
	}

	.track {
		margin: 0;
		padding: 0 0 0.5rem;
		list-style: none;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: min(100%, 23rem);
		gap: 1.25rem;
		align-items: start;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.track::-webkit-scrollbar {
		display: none;
	}

	.quote {
		scroll-snap-align: start;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: var(--radius-ui);
	}

	blockquote {
		margin: 0;
		color: var(--gray-200);
		line-height: 1.5;
	}

	footer {
		border-top: 2px solid var(--accent-regular);
		padding-top: 0.75rem;
	}

