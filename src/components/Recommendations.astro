		border: 1px solid var(--gray-800);
		background: transparent;
		color: var(--gray-0);
		font-size: 1rem;
		cursor: pointer;
		transition: border-color 0.2s, background 0.2s, color 0.2s;
	}

	.nav:hover,
	.nav:focus-visible {
		border-color: var(--accent-regular);
		background: var(--accent-regular);
		color: var(--accent-text-over);
	}
</style>
