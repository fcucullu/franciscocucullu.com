---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
	/** Offside, short lines. Long titles (case studies) stay in Geist. */
	display?: boolean;
}

const { align = 'center', tagline, title, display = false } = Astro.props;
---

<div class:list={['hero stack gap-4', align]}>
	<div class="stack gap-2">
		<h1 class:list={['title', { display }]} set:html={title} />
		{tagline && <p class="tagline" set:html={tagline} />}
	</div>
	<slot />
</div>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: center;
	}

	.title,
	.tagline {
		max-width: 28ch;
		margin-inline: auto;
	}

	.tagline {
		max-width: 42ch;
	}

	.title {
		font-family: var(--font-body);
		font-weight: 600;
		letter-spacing: 0;
		font-size: clamp(1.8rem, 4vw, 2.75rem);
		color: var(--gray-0);
	}

	.title.display {
		font-family: var(--font-display);
		font-weight: 400;
		letter-spacing: -0.02em;
		font-size: clamp(2.35rem, 6vw, 4.25rem);
		max-width: 18ch;
	}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
		}

		.start {
			text-align: start;
		}

		.start .title,
		.start .tagline {
			margin-inline: unset;
		}
	}
</style>
