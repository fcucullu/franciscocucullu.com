---
// Las cuatro cifras de la home.
//
// Antes esto era un bloque decorativo y justo debajo venia una seccion
// "Selected impact" con tres tarjetas que contaban LOS MISMOS tres logros,
// con casi las mismas palabras, a 400px de distancia. Se elimino esa seccion
// y cada cifra pasa a ser la puerta a su caso: el numero promete y la pagina
// enlazada lo demuestra.
const stats = [
	{
		metric: '+137%',
		title: 'Engineering output',
		text: 'Tech Product Manager at an HR fintech. Redesigned how 13 engineers across 3 teams delivered, and lined the roadmap up with what the business actually needed.',
		href: '/work/hastee',
	},
	{
		metric: '24',
		title: 'Engineers led',
		text: 'Four squads on an enterprise product, from strategy through production.',
		href: '/work/ai-quality-assurance',
	},
	{
		metric: 'Sold',
		title: 'To Factorial',
		text: 'Found a gap in their Italian market, built the integration, and sold them the product.',
		href: '/work/timed-integrations',
	},
	{
		// Reemplaza a "3 Startups founded": las tres se cuentan mas abajo, con
		// nombre y detalle, en la seccion de emprendimiento. Esto en cambio era
		// la prueba mas fuerte de la pagina y solo vivia dentro de una tarjeta
		// de las que se borraron.
		metric: '51',
		title: 'Accounts live',
		text: 'A multi-modal AI product in production for a global CX company. Millions saved a year, 50% more efficient.',
		href: '/work/ai-quality-assurance',
	},
];
---

<section data-fast-scroll="scroll_to_skills" class="box skills">
	{stats.map((item) => (
		<a class="stat stack gap-2" href={item.href}>
			<div class="metric">{item.metric}</div>
			<h2>{item.title}</h2>
			<p>{item.text}</p>
		</a>
	))}
</section>

<style>
	.box {
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background-color: var(--gray-999_40);
	}

	.skills {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem 1.5rem;
	}

	.stat {
		text-decoration: none;
		color: inherit;
		border-radius: 0.5rem;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.stat:hover,
	.stat:focus-visible {
		transform: translateY(-2px);
	}

	.stat:hover h2,
	.stat:focus-visible h2 {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.skills h2 {
		font-family: var(--font-body);
		font-size: var(--text-md);
		font-weight: 600;
		letter-spacing: 0;
	}

	.skills p {
		color: var(--gray-300);
		font-size: var(--text-sm);
	}

	.metric {
		font-family: var(--font-display);
		font-size: 2.25rem;
		font-weight: 400;
		color: var(--gray-0);
		line-height: 1;
		letter-spacing: -0.03em;
		box-shadow: inset 0 -0.35rem 0 var(--accent-regular);
		width: fit-content;
	}

	@media (prefers-reduced-motion: reduce) {
		.stat {
			transition: none;
		}

		.stat:hover,
		.stat:focus-visible {
			transform: none;
		}
	}

	@media (min-width: 50em) {
		.box {
			border-radius: 1.5rem;
			padding: 2.5rem;
		}

		.skills {
			grid-template-columns: repeat(4, 1fr);
			gap: 2rem;
		}

		.metric {
			font-size: 2.75rem;
		}
	}
</style>
